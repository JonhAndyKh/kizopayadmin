{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "BASE_PATH=/ PORT=4173 NODE_ENV=production pnpm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/((?!assets(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}